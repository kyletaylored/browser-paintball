{
  "name": "splat-arena",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A browser paintball starter: Vite + TypeScript + three.js + postprocessing, with a small WebSocket game server.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n client,server -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "assets": "tsx scripts/build-assets.ts",
    "check:assets": "tsx scripts/check-assets.ts",
    "start:server": "tsx server/index.ts",
    "start": "node dist-server/index.js",
    "test:server": "tsx server/smoke-test.ts",
    "test:codec": "tsx server/codec-test.ts",
    "test:input": "tsx src/gamepad-test.ts",
    "measure:net": "tsx server/net-measure.ts",
    "test": "npm run test:codec && npm run test:input && npm run test:server",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && npm run build:server",
    "build:server": "vite build --ssr server/index.ts --outDir dist-server --emptyOutDir",
    "preview": "vite preview"
  },
  "dependencies": {
    "node-datachannel": "0.33.6",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/node": "26.6.6",
    "@types/three": "0.187.0",
    "@types/ws": "8.18.2",
    "concurrently": "10.0.7",
    "meshoptimizer": "1.3.0",
    "postprocessing": "6.39.6",
    "three": "0.187.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
