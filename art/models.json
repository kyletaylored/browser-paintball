{
  "$comment": "Models made in Blender (docs/BLENDER.md). npm run assets:blender exports each one to public/models; npm run check:models (CI) checks the committed files still meet these rules.",
  "models": [
    {
      "source": "art/bunkers.py",
      "out": "bunkers.glb",
      "what": "every inflatable bunker on every field, one model per shape and colour",
      "input": "bunkers",
      "nodes": [],
      "animations": {},
      "materials": [
        "trim"
      ],
      "maxTriangles": 150000,
      "maxKB": 450,
      "size": [
        5,
        2.6,
        5
      ]
    },
    {
      "source": "art/player.py",
      "out": "player.glb",
      "what": "the player figures: one rig from scripts/player-rig.ts with every animation, and a head and torso per character (src/characters.ts)",
      "input": "player",
      "clips": "player",
      "nodes": [
        "player",
        "hips",
        "torso",
        "head",
        "shoulderR",
        "elbowR",
        "shoulderL",
        "elbowL",
        "thighR",
        "kneeR",
        "thighL",
        "kneeL",
        "gun",
        "torso_rookie",
        "head_rookie",
        "torso_bruiser",
        "head_bruiser"
      ],
      "animations": {
        "idle": 2.4,
        "run": 0.66,
        "crouch": 2,
        "crouchMove": 0.9,
        "shoot": 0.12,
        "out": 1.6,
        "outWalk": 0.9
      },
      "materials": [
        "team",
        "accent"
      ],
      "maxTriangles": 26000,
      "maxKB": 280,
      "size": [
        1.15,
        1.85,
        1.2
      ]
    },
    {
      "source": "art/pump-marker.py",
      "out": "pump-marker.glb",
      "what": "the first-person pump marker, for pump mode",
      "nodes": [
        "marker",
        "pump",
        "muzzle"
      ],
      "animations": {
        "pump": 0.5
      },
      "materials": [
        "team"
      ],
      "maxTriangles": 6000,
      "maxKB": 60,
      "size": [
        0.1,
        0.4,
        0.9
      ]
    },
    {
      "source": "art/characters/sniper.json",
      "out": "sniper.glb",
      "what": "the sniper: a generated body (art/characters/sniper.glb) on the player rig, coloured from its concept drawings (npm run assets:characters)",
      "nodes": [
        "player",
        "hips",
        "torso",
        "head",
        "shoulderR",
        "elbowR",
        "shoulderL",
        "elbowL",
        "thighR",
        "kneeR",
        "thighL",
        "kneeL",
        "gun",
        "body_sniper"
      ],
      "animations": {
        "idle": 2.4,
        "run": 0.66,
        "crouch": 2,
        "crouchMove": 0.9,
        "shoot": 0.12,
        "out": 1.6,
        "outWalk": 0.9
      },
      "materials": [
        "team",
        "accent"
      ],
      "maxTriangles": 20000,
      "maxKB": 300,
      "size": [
        1.15,
        1.85,
        1.2
      ]
    }
  ]
}
