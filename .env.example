# Game server settings. Copy to .env for local use (never commit .env); on a host, set these as
# environment variables. All are optional; the values below are the defaults.

# port the server listens on (HTTP health check + WebSocket + optionally the website)
PORT=8787
# interface to listen on; empty = all
HOST=
# serve the built website (the dist/ folder) from this directory too; empty = game server only
STATIC_DIR=
# comma-separated web origins allowed to connect, e.g. https://play.example.com; empty = any
ALLOWED_ORIGINS=

# match rules
# which field: arena | tournament | beach | woods (only that one), or rotate (players vote; the most-voted or next one after every match)
MAP=rotate
# firing mode: ramp | semi | pump (only that one), or vote (players vote; more than half switches it after the point)
FIRE_MODE=vote
POINTS_TO_WIN=5
ROUND_SECONDS=120
COUNTDOWN_SECONDS=3
POINT_PAUSE_SECONDS=3
MATCH_OVER_SECONDS=6

# bots: fill each team to this many while anyone is connected (0 = off); easy | normal | hard
BOT_TEAM_SIZE=3
BOT_SKILL=normal

# netcode
LAG_COMPENSATION=1
MAX_REWIND_MS=300
# binary (default) or json
WIRE_FORMAT=binary

# data channels (WebRTC over UDP) for snapshots and input; see docs/DEPLOY.md
# the one UDP port they use; 0 = off. Unset: game port + 1 in development, off in production
RTC_UDP_PORT=
# public address browsers send UDP to, if it isn't this machine's own (NAT, containers, proxies)
RTC_PUBLIC_IP=
# local address or host name to bind the UDP port to; empty = all
RTC_BIND_ADDRESS=

# team voice chat through a LiveKit media server (optional; see docs/DEPLOY.md). Voice is on only when
# all three are set. Never commit real values: copy this file to .env (git-ignored) and fill them in there.
# where browsers reach the media server, e.g. wss://voice.example.com
LIVEKIT_URL=
LIVEKIT_API_KEY=
# at least 32 random characters, e.g. from: openssl rand -base64 32
LIVEKIT_API_SECRET=
VOICE_ROOM=splat-arena
