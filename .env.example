# Game server settings. Copy to .env for local use (never commit .env); on a host, set these as
# environment variables. All are optional; the values below are the defaults.

# port the server listens on (HTTP health check + WebSocket + optionally the website)
PORT=8787
# interface to listen on; empty = all
HOST=
# serve the built website (the dist/ folder) from this directory too; empty = game server only
STATIC_DIR=
# comma-separated web origins allowed to connect, e.g. https://play.example.com; empty = any
ALLOWED_ORIGINS=

# match rules
POINTS_TO_WIN=5
ROUND_SECONDS=120
COUNTDOWN_SECONDS=3
POINT_PAUSE_SECONDS=3
MATCH_OVER_SECONDS=6

# bots: fill each team to this many while anyone is connected (0 = off); easy | normal | hard
BOT_TEAM_SIZE=3
BOT_SKILL=normal

# netcode
LAG_COMPENSATION=1
MAX_REWIND_MS=300
# binary (default) or json
WIRE_FORMAT=binary
